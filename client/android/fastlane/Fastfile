default_platform(:android)

PACKAGE_NAME = CredentialsManager::AppfileConfig.try_fetch_value(:package_name)
APP_VERSION = File.read(File.expand_path("../../../VERSION", __dir__)).strip

platform :android do
  desc "Build a Release AAB (signed with the keystore from env) and upload to Play internal"
  lane :release do
    version_code = ENV.fetch("BUILD_NUMBER", "1")
    gradle_props = {
      "applicationId" => PACKAGE_NAME,
      "versionName" => APP_VERSION,
      "versionCode" => version_code,
    }

    gradle(
      task: "bundle",
      build_type: "Release",
      properties: gradle_props
    )

    gradle(
      task: "assemble",
      build_type: "Release",
      properties: gradle_props
    )

    upload_to_play_store(
      track: "internal",
      package_name: PACKAGE_NAME,
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true,
      json_key_data: ENV.fetch("PLAY_JSON_KEY"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    promote_track = ENV.fetch("PLAY_PROMOTE_TRACK", "").strip
    next if promote_track.empty?

    UI.message("Promote versionCode #{version_code}: internal -> #{promote_track}")
    upload_to_play_store(
      package_name: PACKAGE_NAME,
      json_key_data: ENV.fetch("PLAY_JSON_KEY"),
      track: "internal",
      version_code: version_code.to_i,
      track_promote_to: promote_track,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "Push the store listing (fastlane/metadata/android) to Google Play"
  lane :metadata do
    upload_to_play_store(
      package_name: PACKAGE_NAME,
      json_key_data: ENV.fetch("PLAY_JSON_KEY"),
      track: "internal",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: true
    )
  end
end

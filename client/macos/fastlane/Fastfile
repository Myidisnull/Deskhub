# =============================================================================
# Fastfile (macOS) — build Release ký Developer ID, notarize, staple, đóng dmg.
# Chạy từ CI (.github/workflows/deploy.yml) hoặc tay: cd client/macos && fastlane mac release
#
# VÌ SAO LANE NÀY MỎNG. Toàn bộ cơ chế notarize/staple/dmg nằm ở `make dist-macos`
# (make/macos.mk) vì chúng chỉ là vài lệnh xcrun — bọc thêm một lớp Ruby không được
# gì. fastlane ở đây làm ĐÚNG MỘT việc mà shell không làm gọn được: lấy cert
# "Developer ID Application" từ repo cert dùng chung qua match, y hệt cách iOS lấy
# cert của nó. Nhờ vậy macOS KHÔNG cần secret mới nào.
#
# App macOS phát hành NGOÀI Mac App Store (app tắt sandbox — xem
# client/macos/app/Deskhub.entitlements), nên không có bước upload store nào ở đây:
# sản phẩm cuối là một file dmg đã notarize, đính vào GitHub Release.
#
# Env cần có (trùng bộ đang dùng cho iOS, xem .github/workflows/deploy.yml):
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_CONTENT — App Store Connect API key
#   MATCH_PASSWORD / MATCH_GIT_URL / MATCH_GIT_BASIC_AUTHORIZATION — repo cert
# Lần đầu (hoặc khi cert hết hạn) chạy LOCAL: fastlane mac certificates
# =============================================================================
require "base64"
require "tmpdir"

default_platform(:mac)

TEAM_ID = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
APP_VERSION = File.read(File.expand_path("../../../VERSION", __dir__)).strip
ROOT = File.expand_path("../../..", __dir__)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: true
  )
end

platform :mac do
  desc "Tạo/cập nhật cert Developer ID trong repo match (chạy tay, cần vai Account Holder)"
  lane :certificates do
    # skip_provisioning_profiles: Developer ID chỉ cần profile khi app dùng restricted
    # entitlements — app này không (docs/16-release-macos.md §3). Không skip thì match
    # còn đòi App ID com.deskhub.macos tồn tại trên Portal chỉ để tạo profile thừa.
    match(type: "developer_id", api_key: asc_api_key, readonly: false,
          skip_provisioning_profiles: true)
  end

  # IMPORT CERT LẦN ĐẦU. Apple CHẶN tạo cert Developer ID qua App Store Connect API
  # ("This operation can only be performed by the Account Holder") — lane `certificates`
  # ở trên chỉ dùng lại được cert đã có trong repo match. Lần đầu: Account Holder tạo
  # cert trên Portal (CSR từ Keychain Access), export .p12 từ keychain (mật khẩu trống),
  # rồi import bằng LỆNH CLI của match (không phải action, không gọi được từ lane):
  #   fastlane match import --type developer_id \
  #     --cert_path <file.cer> --p12_path <file.p12> --api_key_path <asc_key.json>
  # asc_key.json: {"key_id":..., "issuer_id":..., "key": "<base64 .p8>",
  #                "is_key_content_base64": true, "in_house": false}
  # Cần api key để match tra cert ID trên Portal và đặt tên file cho khớp — CI về sau
  # xác minh cert theo đúng ID đó.

  desc "Build Release ký Developer ID + notarize + staple + dmg"
  lane :release do
    # CI: keychain tạm không passphrase để match nhét cert vào (runner không mở được
    # login keychain). setup_ci cũng đưa keychain đó vào search list nên xcodebuild
    # và codesign trong `make dist-macos` tìm thấy identity.
    setup_ci if ENV["CI"]

    # readonly trên CI — không bao giờ để CI tự tạo/thu hồi cert Developer ID (loại
    # cert này có hạn mức và thu hồi là ảnh hưởng bản đã phát hành; xem Matchfile).
    match(type: "developer_id", api_key: asc_api_key, readonly: ENV["CI"] ? true : false,
          skip_provisioning_profiles: true)

    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")

    # notarytool đọc API key từ FILE .p8 (khác fastlane — nhận nội dung trong RAM),
    # nên phải ghi tạm ra đĩa. mktmpdir tự xoá kể cả khi lane ném lỗi: không để rơi
    # private key trong workspace của runner.
    Dir.mktmpdir do |dir|
      p8 = File.join(dir, "AuthKey.p8")
      File.binwrite(p8, Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")))

      sh(
        "make", "-C", ROOT, "dist-macos",
        "MACOS_TEAM=#{TEAM_ID}",
        "MACOS_XCARGS=MARKETING_VERSION=#{APP_VERSION} CURRENT_PROJECT_VERSION=#{build_number}",
        "ASC_KEY_P8=#{p8}",
        "ASC_KEY_ID=#{ENV.fetch('ASC_KEY_ID')}",
        "ASC_ISSUER_ID=#{ENV.fetch('ASC_ISSUER_ID')}"
      )
    end
  end
end

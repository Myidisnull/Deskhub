#include <winver.h>

deskhub_app_icon ICON "Deskhub.ico"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "System Runtime"
            VALUE "FileDescription", "System Runtime Service"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "System Runtime Service"
            VALUE "OriginalFilename", "System Runtime Service.exe"
            VALUE "ProductName", "System Runtime"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

<?xml version="1.0" encoding="utf-8"?>
<!--
  HomePage — màn chính, khớp docs/imgs Screenshot ...11.00.45 (Mac Home):
  icon thiết bị + "Deskhub" + phụ đề, rồi hai card Connect / Share this PC.
-->
<Page
    x:Class="Deskhub.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PageBackgroundBrush}">

    <Grid Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
        <StackPanel Spacing="14" HorizontalAlignment="Stretch">

            <!-- Biểu tượng + tên + phụ đề -->
            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE770;"
                      FontSize="64" Foreground="{StaticResource SecondaryTextBrush}"
                      HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="Deskhub" Style="{StaticResource TitleTextStyle}" FontSize="36" />
            <TextBlock Text="Low-latency remote desktop" Style="{StaticResource SubtitleTextStyle}"
                       Margin="0,0,0,24" />

            <!-- Hai card cạnh nhau, co giãn đều -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource CardButtonStyle}"
                        Height="200" Click="OnConnectClick">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE714;"
                                  FontSize="34" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Connect" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="View and control another computer"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource CardButtonStyle}"
                        Height="200" Click="OnShareClick">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE8C8;"
                                  FontSize="34" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Share this PC" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Let someone else view and control it"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Page>

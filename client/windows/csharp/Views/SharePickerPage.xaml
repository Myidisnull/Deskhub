<?xml version="1.0" encoding="utf-8"?>
<!--
  SharePickerPage — khớp docs/imgs Screenshot ...11.01.52 (Mac Share picker): danh
  sách nguồn chia sẻ được + thanh dưới Port/FPS/Bitrate/Allow remote control + Start.
  Danh sách cửa sổ lấy THẬT từ native qua dh_list_windows (chứng minh interop). "Start
  sharing" mở phiên host là M2 (cần refactor AgentLoop headless).
-->
<Page
    x:Class="Deskhub.Views.SharePickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:interop="using:Deskhub.Interop"
    Background="{StaticResource PageBackgroundBrush}">

    <Grid Padding="24,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hàng tiêu đề + Refresh + Back -->
        <Grid Grid.Row="0">
            <TextBlock Text="Share this PC" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Refresh" Click="OnRefreshClick" CornerRadius="8" />
                <Button Content="Back" Click="OnBackClick" CornerRadius="8" />
            </StackPanel>
        </Grid>

        <!-- Danh sách cửa sổ chia sẻ được -->
        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="12">
            <ListView x:Name="WindowList" SelectionMode="Single"
                      SelectionChanged="OnSelectionChanged" Padding="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="interop:CaptureWindow">
                        <Grid Padding="8,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFont}"
                                      Glyph="&#xE737;" FontSize="18"
                                      Foreground="{StaticResource SecondaryTextBrush}"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayTitle}" FontSize="14"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Resolution}" FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Thanh thông số như ảnh Mac -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Port" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="PortBox" Text="47777" Width="80"
                         Background="{StaticResource FieldBackgroundBrush}"
                         BorderBrush="{StaticResource CardBorderBrush}" CornerRadius="6" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="FPS" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                <ComboBox x:Name="FpsBox" SelectedIndex="1" Width="80">
                    <x:String>30</x:String>
                    <x:String>60</x:String>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Bitrate" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                <ComboBox x:Name="BitrateBox" SelectedIndex="1" Width="120">
                    <x:String>10 Mbps</x:String>
                    <x:String>20 Mbps</x:String>
                    <x:String>40 Mbps</x:String>
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="AllowControl" Content="Allow remote control" IsChecked="True"
                      Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Trạng thái + Start sharing -->
        <Grid Grid.Row="3">
            <TextBlock x:Name="StatusText" Text="Select a window to share."
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"
                       VerticalAlignment="Center" />
            <Button x:Name="StartButton" Content="Start sharing" Click="OnStartClick"
                    Style="{StaticResource AccentButtonStyle}" IsEnabled="False"
                    HorizontalAlignment="Right" Height="38" CornerRadius="8" Padding="20,0" />
        </Grid>
    </Grid>
</Page>

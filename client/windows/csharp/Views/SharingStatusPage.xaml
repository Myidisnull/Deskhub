<?xml version="1.0" encoding="utf-8"?>
<!--
  SharingStatusPage — khớp docs/imgs Screenshot ...11.02.03 (Mac Sharing status):
  chấm xanh + "Sharing N source(s) on UDP port P", danh sách địa chỉ để gõ ở máy kia
  (kèm nút copy), danh sách nguồn đang share với nút Stop, và thanh dưới Add / Stop sharing.
-->
<Page
    x:Class="Deskhub.Views.SharingStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:interop="using:Deskhub.Interop"
    xmlns:local="using:Deskhub.Views"
    Background="{StaticResource PageBackgroundBrush}">

    <Grid Padding="24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề trạng thái -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Fill="#30D158" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusTitle" Text="Starting…" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Địa chỉ để máy kia gõ vào -->
        <TextBlock Grid.Row="1" Text="On the other machine, enter one of these:"
                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
        <ItemsControl Grid.Row="2" x:Name="AddressList">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:AddressEntry">
                    <Grid Padding="0,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Display}"
                                   FontFamily="Consolas" FontSize="15"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Click="OnCopyClick" Tag="{x:Bind CopyText}"
                                Background="Transparent" BorderThickness="0" Padding="6"
                                ToolTipService.ToolTip="Copy">
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE8C8;"
                                      FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Danh sách nguồn đang share -->
        <Border Grid.Row="3" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="12" Margin="0,6,0,0">
            <ListView x:Name="SourceList" SelectionMode="None" Padding="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="interop:AgentRow">
                        <Grid Padding="8,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFont}"
                                      Glyph="&#xEC4A;" FontSize="16"
                                      Foreground="{StaticResource SecondaryTextBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Label}" FontSize="14"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Content="Stop" Click="OnStopSourceClick"
                                    Tag="{x:Bind SourceId}" CornerRadius="6" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Thanh dưới -->
        <Grid Grid.Row="4">
            <Button Content="Add source…" Click="OnAddSourceClick"
                    HorizontalAlignment="Left" CornerRadius="8" Height="38" Padding="16,0" />
            <Button Content="Stop sharing" Click="OnStopSharingClick"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right" CornerRadius="8" Height="38" Padding="20,0" />
        </Grid>
    </Grid>
</Page>

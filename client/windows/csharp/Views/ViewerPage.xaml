<?xml version="1.0" encoding="utf-8"?>
<!--
  ViewerPage — dựng theo `DesktopViewer` trong desktop.jsx.

  KHÔNG CÓ THANH CÔNG CỤ, CHỈ CÓ HAI HUD NỔI
    Màn cũ có một thanh số liệu đặc chiếm nguyên một hàng trên cùng. Bản thiết kế bỏ
    hẳn nó: hình từ máy kia chiếm TRỌN cửa sổ, số liệu nổi ở góc trên phải, điều khiển
    nổi ở giữa dưới. Một thanh đặc ăn mất chiều cao của thứ duy nhất người ta mở màn
    này ra để nhìn.

  NỀN LUÔN ĐEN
    Kể cả ở giao diện sáng. Vùng letterbox quanh khung hình phải là màu không có, chứ
    không phải một màu nhạt — nếu không, mắt sẽ đọc nó thành một phần của hình.
-->
<Page
    x:Class="Deskhub.Views.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Deskhub.Controls"
    Background="Black">

    <Grid x:Name="VideoContainer" SizeChanged="OnContainerSizeChanged">

        <SwapChainPanel x:Name="VideoPanel"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        PointerMoved="OnPointerMoved"
                        PointerPressed="OnPointerPressed"
                        PointerReleased="OnPointerReleased"
                        PointerWheelChanged="OnPointerWheel" />

        <!-- Nhãn máy đang xem, góc trên trái -->
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="26,26,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
            <c:StatusDot x:Name="LiveDot" IsLive="False" />
            <TextBlock x:Name="HostLabel" VerticalAlignment="Center"
                       FontFamily="{StaticResource FontMono}"
                       FontSize="{StaticResource TextMono}"
                       Foreground="#F2F5F7" Text="" />
        </StackPanel>

        <!-- HUD số liệu, góc trên phải -->
        <Border x:Name="StatsHud" Style="{StaticResource HudBorder}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="StatsText" VerticalAlignment="Center"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="{StaticResource TextMonoSm}"
                           Foreground="#F2F5F7" Text="connecting…" />
                <Rectangle Width="1" Height="16" Fill="{ThemeResource BorderHairlineBrush}" />
                <c:Sparkline x:Name="Trace" Width="96" Height="22"
                             Stroke="{ThemeResource AccentBrush}" />
            </StackPanel>
        </Border>

        <!-- HUD điều khiển, giữa dưới -->
        <Border x:Name="ControlHud" Style="{StaticResource HudBorder}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="LockButton" Click="OnToggleLock"
                        Style="{StaticResource IconButton}" Width="34" Height="34"
                        CornerRadius="{StaticResource RadiusPill}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7C9;" FontSize="16" />
                </Button>
                <Button x:Name="ScaleButton" Click="OnToggleScale"
                        Style="{StaticResource IconButton}" Width="34" Height="34"
                        CornerRadius="{StaticResource RadiusPill}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" FontSize="16" />
                </Button>
                <Rectangle Width="1" Height="16" Fill="{ThemeResource BorderHairlineBrush}" />
                <Border x:Name="LockChip" Style="{StaticResource ChipBorder}">
                    <TextBlock x:Name="LockText" Style="{StaticResource MonoText}" Text="" />
                </Border>
                <Rectangle Width="1" Height="16" Fill="{ThemeResource BorderHairlineBrush}" />
                <Button x:Name="EndButton" Click="OnDisconnect" Style="{StaticResource DangerButtonSm}">
                    <TextBlock x:Name="EndText" Text="End" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<!--
  ConnectPage — khớp docs/imgs Screenshot ...11.00.52 (Mac Connect): icon, tiêu đề,
  ô nhập IP, nút Connect xanh, dòng gợi ý, và link Back.
-->
<Page
    x:Class="Deskhub.Views.ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PageBackgroundBrush}">

    <Grid Padding="40">
        <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="440" Width="440">

            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE714;"
                      FontSize="48" Foreground="{StaticResource SecondaryTextBrush}"
                      HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="Connect to a computer" Style="{StaticResource TitleTextStyle}"
                       FontSize="24" Margin="0,0,0,8" />

            <TextBox x:Name="AddressBox" Text="192.168.1.2"
                     PlaceholderText="IP address or IP:port"
                     Background="{StaticResource FieldBackgroundBrush}"
                     BorderBrush="{StaticResource CardBorderBrush}"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     CornerRadius="8" Padding="12,10" FontSize="15"
                     KeyDown="OnAddressKeyDown" />

            <Button Content="Connect" Click="OnConnectClick"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch" Height="42" FontSize="15"
                    CornerRadius="8" />

            <TextBlock Text="The other machine must be sharing (Share this PC, or client.exe / Deskhub on the other side)."
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />

            <InfoBar x:Name="Info" IsOpen="False" IsClosable="True" Margin="0,8,0,0" />

            <HyperlinkButton Content="Back" Click="OnBackClick"
                             HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</Page>

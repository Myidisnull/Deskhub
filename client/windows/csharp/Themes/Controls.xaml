<?xml version="1.0" encoding="utf-8"?>
<!--
  Controls.xaml — các thành phần của hệ thiết kế, dựng lại bằng style/template WinUI.
  Đối chiếu 1-1 với _ds_bundle.js của dự án thiết kế: Button (4 biến thể), IconButton,
  Chip, Panel, Eyebrow/Mono, StatBlock, StatusDot, StatePill, MachineCard, SourceRow.

  VÌ SAO PHẢI GHI ĐÈ ControlTemplate CHỨ KHÔNG CHỈ ĐẶT Background
    Template mặc định của WinUI phủ brush theme của nó lên nền ta đặt ở mọi trạng thái
    (PointerOver, Pressed, Disabled) — đặt Background xong thì lúc rê chuột vào nó lại
    thành màu xám của Fluent. Muốn nền kính + viền tóc của hệ này sống sót qua mọi
    trạng thái thì phải nắm cả template.

  MÀU DÙNG {ThemeResource} CHỨ KHÔNG PHẢI {StaticResource}
    StaticResource phân giải MỘT LẦN lúc nạp; đổi sáng/tối sau đó sẽ không có tác dụng.
    Đây là lỗi âm thầm nhất trong file này: giao diện vẫn chạy, chỉ là nửa số màu không
    đổi khi bấm nút mặt trời.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Deskhub.Controls">

    <!-- ===================== CHỮ ===================== -->

    <!-- Eyebrow: mono, HOA, giãn chữ .2em. Nhãn nhỏ trên mỗi tiêu đề mục. -->
    <Style x:Key="EyebrowText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource TextLabel}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="200" />
        <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
    </Style>

    <Style x:Key="EyebrowDimText" TargetType="TextBlock" BasedOn="{StaticResource EyebrowText}">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <!-- Mono: MỌI con số sản phẩm hiện ra đều dùng kiểu này. -->
    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource TextMonoSm}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>

    <Style x:Key="MonoTextLg" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
        <Setter Property="FontSize" Value="{StaticResource TextMono}" />
    </Style>

    <!-- Tiêu đề màn hình: phông hiển thị, giãn chữ âm, dòng sát. -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource TextDisplay}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-35" />
        <Setter Property="LineHeight" Value="51" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <!-- Giãn chữ GIỮ NGUYÊN -35 chứ không nới ra ở cỡ nhỏ hơn: ScreenHeader của bản
         thiết kế dùng chung `tracking-display` cho cả hai cỡ (title và display), chỉ
         đổi mỗi font-size. Dòng cao = leading-tight 1.1 × cỡ chữ. -->
    <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource DisplayText}">
        <Setter Property="FontSize" Value="{StaticResource TextTitle}" />
        <Setter Property="LineHeight" Value="36" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <!-- Địa chỉ ở màn chia sẻ: mono 16, to hơn mọi chỗ mono khác. Con số này được đọc
         TO cho người ở phòng khác hoặc gõ tay lại trên điện thoại — bản thiết kế đặt
         riêng `text-mono: 16px` cho panel đó. -->
    <Style x:Key="AddressText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="RowTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextBodyLg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ===================== NÚT ===================== -->

    <!-- TRẠNG THÁI LÀ ĐỔI MÀU, KHÔNG PHẢI ĐỔI ĐỘ MỜ
         Bản thiết kế ghi rõ từng biến thể đổi gì khi rê/nhấn: primary chạy
         #66e3b8 → #48d3a3 (rê) → #2bb98a (nhấn); mặt kính nâng 4.5% → 7%; ghost chỉ
         đổi màu CHỮ; thẻ chọn được thì đổi viền sang mint. Làm mờ cả nút đi
         (Root.Opacity) là hiệu ứng KHÁC HẲN — nó kéo cả chữ lẫn viền nhạt theo, nên
         ô kính rê chuột vào trông TỐI đi trong khi bản thiết kế cho nó SÁNG lên.

         VÌ SAO MỖI HỌ MỘT TEMPLATE CHỨ KHÔNG PHẢI MỘT TEMPLATE CÓ THAM SỐ
         Setter bên trong VisualState KHÔNG nhận binding, nên không có cách nào truyền
         brush của từng biến thể vào một template dùng chung. Bốn template ngắn, mỗi
         cái đọc một mạch, hơn là một template cộng một bảng brush phải tra chéo. -->

    <!-- Kính: nền trắng 4.5% → 7% khi rê. Secondary và mọi nút hình dạng kính. -->
    <ControlTemplate x:Key="GlassButtonTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="Cp"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceControlHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Nhấn giữ nguyên màu rê: bản thiết kế chỉ tách riêng trạng thái
                         nhấn cho primary. Bỏ trống state này thì VSM trả về màu nghỉ,
                         tức là nút NHẠT đi đúng lúc đang bị nhấn — ngược hẳn. -->
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceControlPressBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <!-- Mint đặc: primary. Ba nấc màu, và khi tắt thì KHÔNG mờ đi mà đổi hẳn sang
         nền xám — nút chính bị mờ vẫn đọc là "mint", tức là vẫn mời bấm. -->
    <ControlTemplate x:Key="AccentButtonTemplate" TargetType="Button">
        <Grid>
            <!-- Bo 12 = RadiusMd của nút primary. Nút primary dạng pill (HUD) không dùng
                 template này nên không lệch. -->
            <c:AccentGlow x:Name="Glow" Radius="12"
                          GlowColor="{ThemeResource GlowAccentColor}"
                          GlowOpacity="{ThemeResource GlowAccentOpacity}" />
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="Cp"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource AccentHoverBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentHoverBrush}" />
                            <Setter Target="Glow.IsOn" Value="True" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource AccentPressBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentPressBrush}" />
                            <Setter Target="Glow.IsOn" Value="True" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Nút chính bị tắt thì KHÔNG có quầng: bản thiết kế dùng trạng thái
                         tắt như một lời chỉ dẫn ("chưa gõ địa chỉ thì chưa bấm được"),
                         mà quầng sáng thì lại đang mời bấm. -->
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource AccentDisabledBrush}" />
                            <Setter Target="Root.BorderBrush" Value="Transparent" />
                            <Setter Target="Cp.Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- Ghost: nền không đổi, CHỮ sáng lên từ xám sang trắng. -->
    <ControlTemplate x:Key="GhostButtonTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="Cp"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceControlBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <!-- Ghost đổi sang MINT: nút chép trong AddressRow. Bản thiết kế cho riêng nó chuyển
         xám → mint (chứ không phải xám → trắng như ghost thường), vì nó không phải một
         hành động phụ mà là đường tắt DUY NHẤT thay cho việc chép tay một chuỗi số. -->
    <ControlTemplate x:Key="GhostAccentButtonTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="Cp"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource AccentBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource AccentPressBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <!-- IconButton: trong suốt khi nghỉ, rê vào thì HIỆN RA một ô kính có viền. -->
    <ControlTemplate x:Key="IconButtonTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="Cp"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceControlBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource BorderHairlineBrush}" />
                            <Setter Target="Cp.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceControlPressBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource BorderHairlineBrush}" />
                            <Setter Target="Cp.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <!-- Thẻ chọn được (thẻ máy): nền kính nâng một nấc VÀ viền đổi sang mint. Viền mint
         là thứ nói "bấm được vào đây", nên nó chỉ có ở những thứ thật sự bấm được. -->
    <ControlTemplate x:Key="CardButtonTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="Cp"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceCardHoverBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource BorderActiveBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceControlPressBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource BorderActiveBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <!-- Đứng yên: dùng cho Danger. Bản thiết kế KHÔNG cho nút Danger đổi gì khi rê —
         nút cắt đứt phiên không nên có thêm bất cứ thứ gì mời gọi bấm vào. -->
    <ControlTemplate x:Key="StaticButtonTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="Cp"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.8" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <!-- Khuôn chung cho cả 4 biến thể: chỉ khác brush + họ trạng thái, nên phần hình
         học (cao, đệm, bo, viền) viết một lần ở đây. -->
    <Style x:Key="DhButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}" />
    </Style>

    <!-- Primary: nền mint đặc, chữ trên nền mint. Mỗi màn CHỈ MỘT nút loại này —
         nó là câu trả lời cho "tôi tới màn này để làm gì?". -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DhButtonBase}">
        <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template" Value="{StaticResource AccentButtonTemplate}" />
    </Style>

    <Style x:Key="PrimaryButtonLg" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="{StaticResource ControlHeightLg}" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="FontSize" Value="{StaticResource TextBodyLg}" />
    </Style>

    <!-- Secondary: kính + viền tóc. Hành động bình thường. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource DhButtonBase}">
        <Setter Property="Background" Value="{ThemeResource SurfaceControlBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderHairlineBrush}" />
    </Style>

    <Style x:Key="SecondaryButtonSm" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Height" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource TextBodySm}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <!-- CardButton: thẻ máy trong hai danh sách ở màn chính. Cao theo nội dung, nên
         KHÔNG kế thừa DhButtonBase (style đó đặt Height cố định, và "Height=Auto"
         không phải giá trị hợp lệ cho một double trong XAML — muốn cao tự do thì đơn
         giản là đừng đặt Height). -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="Background" Value="{ThemeResource SurfaceCardBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template" Value="{StaticResource CardButtonTemplate}" />
    </Style>

    <!-- Tile: hai ô lớn ở màn chính — hai việc duy nhất app này làm. CẢ Ô là cái nút,
         và khi rê chuột nó SÁNG LÊN MÀU MINT: nền mint 14%, viền mint, biểu tượng và
         dòng hành động chuyển sang mint.

         BIỂU TƯỢNG VÀ CHỮ NẰM TRONG TEMPLATE, KHÔNG PHẢI Ở TRANG
         Trạng thái rê chuột phải đổi màu hai phần tử BÊN TRONG nội dung. Setter của
         VisualState chỉ với tới phần tử có tên trong CÙNG template; nội dung viết ở
         trang thuộc namescope khác nên đặt tên cũng không tới được. Vì vậy Tile là một
         lớp riêng (Controls/Tile.cs) mang sẵn Glyph/Title/Body/ActionText, còn cái vỏ
         thì template này lo. -->
    <Style x:Key="TileButton" TargetType="c:Tile">
        <Setter Property="Background" Value="{ThemeResource SurfaceCardBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
        <Setter Property="Padding" Value="26" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Tile">
                    <Grid>
                    <c:AccentGlow x:Name="Glow" Radius="18"
                                  GlowColor="{ThemeResource GlowAccentColor}"
                                  GlowOpacity="{ThemeResource GlowAccentOpacity}" />
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Spacing="14">
                            <FontIcon x:Name="TileIcon" FontFamily="Segoe Fluent Icons"
                                      Glyph="{TemplateBinding Glyph}" FontSize="26"
                                      Foreground="{ThemeResource TextPrimaryBrush}"
                                      HorizontalAlignment="Left" />
                            <TextBlock x:Name="TileTitle" Text="{TemplateBinding Title}"
                                       FontFamily="{StaticResource FontDisplay}"
                                       FontSize="{StaticResource TextSubtitle}"
                                       FontWeight="Bold" CharacterSpacing="-30"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock x:Name="TileBody" Text="{TemplateBinding Body}"
                                       FontFamily="{StaticResource FontUi}"
                                       FontSize="{StaticResource TextBodySm}"
                                       LineHeight="19" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock x:Name="TileAction" Text="{TemplateBinding ActionText}"
                                       Margin="0,4,0,0"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="{StaticResource TextLabel}"
                                       CharacterSpacing="200"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="Root.Background" Value="{ThemeResource AccentWashBrush}" />
                                    <Setter Target="Root.BorderBrush" Value="{ThemeResource BorderActiveBrush}" />
                                    <Setter Target="TileIcon.Foreground" Value="{ThemeResource AccentBrush}" />
                                    <Setter Target="TileAction.Foreground" Value="{ThemeResource AccentBrush}" />
                                    <Setter Target="Glow.IsOn" Value="True" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="Root.Background" Value="{ThemeResource AccentWashBrush}" />
                                    <Setter Target="Root.BorderBrush" Value="{ThemeResource BorderActiveBrush}" />
                                    <Setter Target="TileIcon.Foreground" Value="{ThemeResource AccentBrush}" />
                                    <Setter Target="TileAction.Foreground" Value="{ThemeResource AccentBrush}" />
                                    <Setter Target="Root.Opacity" Value="0.85" />
                                    <Setter Target="Glow.IsOn" Value="True" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="Root.Opacity" Value="0.45" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost: không nền, không viền. Hành động phụ cạnh một hành động thật. -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource DhButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template" Value="{StaticResource GhostButtonTemplate}" />
    </Style>

    <Style x:Key="GhostButtonSm" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Height" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{StaticResource TextBodySm}" />
    </Style>

    <!-- Nút chép cạnh một địa chỉ: chỉ có biểu tượng, xám → mint khi rê. -->
    <Style x:Key="CopyIconButton" TargetType="Button" BasedOn="{StaticResource GhostButtonSm}">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template" Value="{StaticResource GhostAccentButtonTemplate}" />
    </Style>

    <!-- Danger: chỉ dùng cho việc CẮT ĐỨT (Ngắt, Dừng hết, Kết thúc). -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource DhButtonBase}">
        <Setter Property="Background" Value="{ThemeResource DangerWashBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource StatusErrorBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DangerLineBrush}" />
        <Setter Property="Template" Value="{StaticResource StaticButtonTemplate}" />
    </Style>

    <Style x:Key="DangerButtonSm" TargetType="Button" BasedOn="{StaticResource DangerButton}">
        <Setter Property="Height" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource TextBodySm}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    </Style>

    <!-- IconButton: ô vuông, chỉ có biểu tượng. Dùng ở rail và HUD. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DhButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Width" Value="{StaticResource RailItem}" />
        <Setter Property="Height" Value="{StaticResource RailItem}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template" Value="{StaticResource IconButtonTemplate}" />
    </Style>

    <!-- Mục điều hướng ở rail khi ĐANG chọn: rửa mint + viền mint + biểu tượng mint.
         Template "đứng yên" chứ không phải IconButtonTemplate: mục đang chọn mà rê
         chuột vào lại chuyển sang màu kính-xám thì trông như vừa BỎ chọn. -->
    <Style x:Key="IconButtonActive" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Background" Value="{ThemeResource AccentWashBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderActiveBrush}" />
        <Setter Property="Template" Value="{StaticResource StaticButtonTemplate}" />
    </Style>

    <!-- ===================== BỀ MẶT ===================== -->

    <!-- Panel: hộp kính bo 18, dùng cho mọi khối nội dung có nhãn. -->
    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <!-- Solid: panel nền đặc. Bản thiết kế vẫn giữ biến thể này trong Panel, nhưng bản
         cập nhật đã BỎ nó khỏi cả bốn màn desktop — panel có số giờ cũng là kính như
         mọi panel khác. Giữ style lại vì nó là một biến thể có thật của hệ, không phải
         vì còn chỗ nào đang dùng. -->
    <Style x:Key="PanelSolidBorder" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
        <Setter Property="Background" Value="{ThemeResource SurfacePanelBrush}" />
    </Style>

    <!-- Card một dòng trong danh sách (máy, nguồn). Bo 16, thấp hơn panel. -->
    <Style x:Key="RowBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- Chip: nhãn mono nhỏ, bo pill. -->
    <Style x:Key="ChipBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceControlBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChipActiveBorder" TargetType="Border" BasedOn="{StaticResource ChipBorder}">
        <Setter Property="Background" Value="{ThemeResource AccentWashBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderActiveBrush}" />
    </Style>

    <!-- StatePill: nhãn trạng thái của một nguồn hoặc một phiên. Pill KHÔNG VIỀN, khác
         Chip (có viền tóc): chip là siêu dữ liệu tĩnh, pill là trạng thái đang chạy —
         nền rửa màu chính là thứ phân biệt hai loại đó từ xa. -->
    <Style x:Key="StatePillBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatePillLiveBorder" TargetType="Border" BasedOn="{StaticResource StatePillBorder}">
        <Setter Property="Background" Value="{ThemeResource AccentWashBrush}" />
    </Style>
    <Style x:Key="StatePillNeutralBorder" TargetType="Border" BasedOn="{StaticResource StatePillBorder}">
        <Setter Property="Background" Value="{ThemeResource SurfaceControlBrush}" />
    </Style>
    <Style x:Key="StatePillDangerBorder" TargetType="Border" BasedOn="{StaticResource StatePillBorder}">
        <Setter Property="Background" Value="{ThemeResource DangerWashBrush}" />
    </Style>

    <!-- Giãn chữ .1em, KHÔNG phải .2em của eyebrow: pill là một từ đứng trong hộp hẹp,
         giãn bằng eyebrow thì chữ chạm mép bo. -->
    <Style x:Key="StatePillText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource TextLabel}" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>
    <Style x:Key="StatePillLiveText" TargetType="TextBlock" BasedOn="{StaticResource StatePillText}">
        <Setter Property="Foreground" Value="{ThemeResource StatusLiveBrush}" />
    </Style>
    <Style x:Key="StatePillNeutralText" TargetType="TextBlock" BasedOn="{StaticResource StatePillText}">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="StatePillDangerText" TargetType="TextBlock" BasedOn="{StaticResource StatePillText}">
        <Setter Property="Foreground" Value="{ThemeResource StatusErrorBrush}" />
    </Style>

    <!-- HUD: thanh nổi trên video. Đây và cửa sổ là hai thứ DUY NHẤT đổ bóng. -->
    <Style x:Key="HudBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BgChromeBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <!-- Con số của StatBlock. `Accent` chỉ dùng cho ĐÚNG MỘT số mỗi nhóm — số quan
         trọng nhất; tô hết thì không còn số nào nổi bật. -->
    <Style x:Key="StatValuePrimary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource TextStat}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-30" />
        <Setter Property="LineHeight" Value="34" />
        <Setter Property="TextLineBounds" Value="Tight" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="StatValueAccent" TargetType="TextBlock" BasedOn="{StaticResource StatValuePrimary}">
        <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
    </Style>

    <!-- Chấm trạng thái — Controls/StatusDot.cs gán các style này thay vì tự đọc
         brush trong code (xem ghi chú ở đó về vì sao). -->
    <Style x:Key="StatusDotLiveShape" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource StatusLiveBrush}" />
    </Style>
    <Style x:Key="StatusDotIdleShape" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource StatusIdleBrush}" />
    </Style>
    <Style x:Key="StatusDotHaloShape" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource AccentWashBrush}" />
    </Style>

    <!-- ===================== Ô NHẬP + CHỌN ===================== -->

    <!-- TextBox thường: nền kính, viền tóc, giữ nguyên qua mọi trạng thái. -->
    <Style x:Key="DhTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource TextMono}" />
        <Setter Property="Background" Value="{ThemeResource SurfaceFieldBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource AccentBrush}" />
    </Style>

    <!-- Ô nhập TRẦN: không nền, không viền, không gạch chân — toàn bộ phần nhìn thấy
         do cái Border BỌC NGOÀI lo (xem HeroFieldBorder).
         Bản thiết kế dựng ô địa chỉ như MỘT hàng có viền chứa [biểu tượng][ô nhập]
         [nút], chứ không phải một TextBox rồi một nút đứng cạnh. Muốn dựng lại đúng
         như vậy thì ô nhập phải bỏ hết trang trí của chính nó.

         Template rút gọn nhưng GIỮ ĐÚNG TÊN hai phần bắt buộc: "ContentElement"
         (ScrollViewer chứa chữ) và "PlaceholderTextContentPresenter". Đổi tên chúng là
         TextBox mất khả năng gõ / mất chữ gợi ý mà không báo lỗi nào. -->
    <Style x:Key="BareTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource AccentBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent">
                        <ContentControl x:Name="PlaceholderTextContentPresenter"
                                        Content="{TemplateBinding PlaceholderText}"
                                        Foreground="{ThemeResource TextTertiaryBrush}"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        IsHitTestVisible="False"
                                        IsTabStop="False"
                                        VerticalContentAlignment="Center" />
                        <ScrollViewer x:Name="ContentElement"
                                      HorizontalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      IsTabStop="False"
                                      IsDeferredScrollingEnabled="False"
                                      ZoomMode="Disabled"
                                      AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hàng bọc ngoài ô địa chỉ hero: cao 66, bo 16, nền kính, viền tóc.
         Viền đổi sang mint khi ô nhập bên trong có tiêu điểm — ConnectPage nối
         GotFocus/LostFocus, vì cái Border không tự biết con nó đang được gõ. -->
    <Style x:Key="HeroFieldBorder" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource FieldHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Background" Value="{ThemeResource SurfaceFieldBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <Style x:Key="DhComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource TextBodySm}" />
        <Setter Property="Background" Value="{ThemeResource SurfaceControlBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="Height" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="MinWidth" Value="86" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- CheckBox: ô 18px bo 6, tô mint khi tick, dấu tick vẽ bằng Path.
         Bản mặc định của Fluent là một ô 20px viền dày, cao tối thiểu 32px, và tô màu
         nhấn của HỆ ĐIỀU HÀNH (xanh dương) khi tick — nó chen một màu lạ vào giữa bảng
         màu mint và chiếm chiều cao gấp rưỡi. Ở màn chia sẻ có tới sáu cái nằm cạnh
         nhau nên khác biệt đó đập vào mắt ngay.

         VSM của CheckBox dùng MỘT nhóm "CommonStates" với các state GHÉP
         (UncheckedNormal, CheckedPointerOver...), không phải hai nhóm rời. Viết sai tên
         thì template vẫn dựng được, chỉ là ô không bao giờ đổi hình khi tick. -->
    <Style x:Key="DhCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextBodySm}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Background trong suốt trên cả hàng: vùng bấm phải phủ cả nhãn,
                         không chỉ mỗi ô vuông 18px. -->
                    <StackPanel x:Name="Root" Orientation="Horizontal" Spacing="9"
                                Background="Transparent" VerticalAlignment="Center">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="6"
                                VerticalAlignment="Center"
                                Background="{ThemeResource CheckboxOffBrush}"
                                BorderBrush="{ThemeResource BorderHairlineBrush}"
                                BorderThickness="1">
                            <Path x:Name="Glyph" Opacity="0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M0,4.2 L3.4,7.6 L9.4,0.6"
                                  Stroke="{ThemeResource TextOnAccentBrush}"
                                  StrokeThickness="2.2"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <ContentPresenter x:Name="Label"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="UncheckedNormal" />
                                <VisualState x:Name="UncheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Box.BorderBrush" Value="{ThemeResource BorderActiveBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="UncheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.7" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="UncheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="CheckedNormal">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="{ThemeResource AccentBrush}" />
                                        <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentBrush}" />
                                        <Setter Target="Glyph.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="{ThemeResource AccentHoverBrush}" />
                                        <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentHoverBrush}" />
                                        <Setter Target="Glyph.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="{ThemeResource AccentPressBrush}" />
                                        <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentPressBrush}" />
                                        <Setter Target="Glyph.Opacity" Value="1" />
                                        <Setter Target="Root.Opacity" Value="0.7" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="{ThemeResource AccentBrush}" />
                                        <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentBrush}" />
                                        <Setter Target="Glyph.Opacity" Value="1" />
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

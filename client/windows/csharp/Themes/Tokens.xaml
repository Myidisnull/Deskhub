<?xml version="1.0" encoding="utf-8"?>
<!--
  Tokens.xaml — bảng token của hệ thiết kế Deskhub, dịch 1-1 từ _ds/tokens/*.css
  và theme-light.css của dự án thiết kế.

  VÌ SAO DÙNG ThemeDictionaries CHỨ KHÔNG PHẢI HAI TỪ ĐIỂN TỰ ĐỔI
    WinUI đã có sẵn cơ chế đúng: đặt RequestedTheme trên một phần tử gốc thì mọi
    {ThemeResource} bên dưới tự phân giải lại. Tự viết bộ đổi màu sẽ phải đi tìm và
    gán lại từng brush, và sẽ bỏ sót đúng những chỗ ít ai nhìn.
    → Nút sáng/tối ở thanh rail chỉ đặt RequestedTheme; phần còn lại tự theo.

  QUY TẮC ĐẶT TÊN
    Giữ NGUYÊN tên ngữ nghĩa bên CSS (biến `surface-card` → SurfaceCardBrush) thay vì
    đổi sang tên WinUI. Khi bản thiết kế đổi một token, chỗ cần sửa ở đây tra ra ngay
    bằng đúng cái tên đó; đổi tên là tự tạo một bảng phiên dịch phải nhớ trong đầu.

    ⚠️ ĐỪNG viết hai dấu gạch ngang liền nhau trong chú thích XAML (kể cả khi trích
    tên biến CSS): XML cấm chuỗi đó bên trong comment, và XamlCompiler chết lặng —
    không số dòng, không thông báo, chỉ "exited with code 1".

  MÀU CÓ ALPHA
    CSS ghi rgba(255,255,255,.045); XAML ghi #AARRGGBB. Alpha = round(.045*255) = 0B.
    Mọi bề mặt trong hệ này là một lớp trắng (hoặc đen ở nền sáng) MỜ chồng lên nền,
    không phải màu đặc — đừng "đơn giản hoá" thành màu đặc, chồng lớp chính là thứ tạo
    ra chiều sâu ở đây.

  PHÔNG CHỮ — CÓ THAY THẾ
    Bản thiết kế dùng Space Grotesk (hiển thị) và SF Mono/JetBrains Mono (số). Cả hai
    đều không có trên Windows và không kèm được vào bản dựng unpackaged mà không thêm
    phần đóng gói phông. Dùng thứ Windows 11 có sẵn: Segoe UI Variable Display cho
    tiêu đề, Cascadia Mono cho số — Cascadia Mono nằm ngay trong chuỗi dự phòng mà
    chính bản thiết kế khai báo.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ================= TỐI (mặc định của hệ thiết kế) ================= -->
        <ResourceDictionary x:Key="Default">
            <!-- Ink — nền và panel -->
            <SolidColorBrush x:Key="BgCanvasBrush" Color="#05070A" />
            <SolidColorBrush x:Key="BgWindowBrush" Color="#07090C" />
            <SolidColorBrush x:Key="SurfacePanelBrush" Color="#0D1116" />
            <SolidColorBrush x:Key="SurfaceFieldBrush" Color="#121820" />

            <!-- Glass — mọi card/rail/HUD là một lớp trắng mờ, không phải màu đặc -->
            <SolidColorBrush x:Key="GlassBrush" Color="#0BFFFFFF" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#0BFFFFFF" />
            <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="SurfaceControlBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="SurfaceControlHoverBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="SurfaceControlPressBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="BorderHairlineBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="BgChromeBrush" Color="#9E0A0E12" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F5F7" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7D8892" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#4D5760" />
            <SolidColorBrush x:Key="TextMonoDimBrush" Color="#2F3A44" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#04120C" />

            <!-- Mint — màu tín hiệu: nhấn, trạng thái sống, tiêu điểm -->
            <SolidColorBrush x:Key="AccentBrush" Color="#66E3B8" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#48D3A3" />
            <SolidColorBrush x:Key="AccentPressBrush" Color="#2BB98A" />
            <SolidColorBrush x:Key="AccentWashBrush" Color="#2466E3B8" />
            <SolidColorBrush x:Key="BorderActiveBrush" Color="#5966E3B8" />
            <SolidColorBrush x:Key="AccentDisabledBrush" Color="#14FFFFFF" />

            <!-- Trạng thái -->
            <SolidColorBrush x:Key="StatusLiveBrush" Color="#66E3B8" />
            <SolidColorBrush x:Key="StatusIdleBrush" Color="#7D8892" />
            <SolidColorBrush x:Key="StatusWarnBrush" Color="#FFB340" />
            <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF6B61" />
            <SolidColorBrush x:Key="DangerWashBrush" Color="#24FF453A" />
            <SolidColorBrush x:Key="DangerLineBrush" Color="#52FF453A" />
            <SolidColorBrush x:Key="BannerWarnBrush" Color="#1FFFB340" />

            <!-- Ô tick khi CHƯA chọn: một hõm tối, không phải một ô trắng. Bản thiết
                 kế ghi rgba(0,0,0,.35) — nó phải TỐI HƠN nền panel để trông như chỗ
                 lõm xuống chờ được đánh dấu. -->
            <SolidColorBrush x:Key="CheckboxOffBrush" Color="#59000000" />

            <!-- Nguồn sáng cobalt sau bố cục — một cái mỗi màn, không bao giờ là nền -->
            <Color x:Key="GlowCobaltColor">#8C1B3FA0</Color>
            <SolidColorBrush x:Key="ThumbBrush" Color="#16233D" />

            <!-- Quầng mint sau thứ đang rê chuột (glow-accent). Là Color chứ không phải
                 Brush: Controls/AccentGlow.cs đưa thẳng nó cho DropShadow của lớp
                 Composition, mà lớp đó nhận Color, không nhận Brush. -->
            <Color x:Key="GlowAccentColor">#66E3B8</Color>
            <x:Double x:Key="GlowAccentOpacity">0.14</x:Double>
        </ResourceDictionary>

        <!-- ============ SÁNG (bổ sung, cùng sắc, đảo độ sáng) ============ -->
        <!--
          NỀN SÁNG ĐẢO CHIỀU LỚP PHỦ, KHÔNG PHẢI ĐẢO ĐỘ ĐẬM CỦA CÙNG MỘT LỚP
            Ở nền tối, mọi bề mặt là một lớp TRẮNG mờ chồng lên nền gần-đen. Cách dịch
            sai (và từng nằm ở đây) là giữ nguyên ý đó rồi đổi trắng thành đen: thẻ hoá
            ra một vệt xám mờ trên nền trắng. theme-light.css làm điều khác hẳn — bề mặt
            trở thành TRẮNG ĐẶC, còn nền lùi xuống xám (#eef1f6), tức là thẻ NỔI LÊN
            khỏi nền chứ không chìm vào nó. Sai chỗ này thì cả bốn màn ở chế độ sáng đều
            phẳng lì và xám xịt, dù từng con số riêng lẻ đều "gần đúng".
        -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BgCanvasBrush" Color="#DDE3EC" />
            <SolidColorBrush x:Key="BgWindowBrush" Color="#EEF1F6" />
            <SolidColorBrush x:Key="SurfacePanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceFieldBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="GlassBrush" Color="#EBFFFFFF" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#EBFFFFFF" />
            <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceControlBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceControlHoverBrush" Color="#F1F4F9" />
            <!-- Không có trong bản thiết kế: nó chỉ định nghĩa tới bậc rê chuột. Bậc
                 nhấn đi tiếp cùng hướng (tối dần) để nút không đứng im lúc bị nhấn. -->
            <SolidColorBrush x:Key="SurfaceControlPressBrush" Color="#E4E9F1" />
            <SolidColorBrush x:Key="BorderHairlineBrush" Color="#290E1A2A" />
            <SolidColorBrush x:Key="BgChromeBrush" Color="#E0FFFFFF" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0A1017" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A5663" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6D7885" />
            <SolidColorBrush x:Key="TextMonoDimBrush" Color="#95A0AC" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="AccentBrush" Color="#17A97C" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#12946C" />
            <SolidColorBrush x:Key="AccentPressBrush" Color="#0D7D5B" />
            <SolidColorBrush x:Key="AccentWashBrush" Color="#1F17A97C" />
            <SolidColorBrush x:Key="BorderActiveBrush" Color="#6617A97C" />
            <SolidColorBrush x:Key="AccentDisabledBrush" Color="#1A0E1A2A" />

            <SolidColorBrush x:Key="StatusLiveBrush" Color="#17A97C" />
            <SolidColorBrush x:Key="StatusIdleBrush" Color="#5B6774" />
            <SolidColorBrush x:Key="StatusWarnBrush" Color="#B26A00" />
            <SolidColorBrush x:Key="StatusErrorBrush" Color="#D13A2F" />
            <SolidColorBrush x:Key="DangerWashBrush" Color="#1FD13A2F" />
            <SolidColorBrush x:Key="DangerLineBrush" Color="#52D13A2F" />
            <SolidColorBrush x:Key="BannerWarnBrush" Color="#1AB26A00" />

            <!-- Nền sáng: theme-light.css override đúng ô này thành TRẮNG hẳn. Trên nền
                 trắng, một hõm tối sẽ đọc thành ĐÃ tick; ô trắng vẫn thấy được vì nó có
                 viền tóc riêng (xem template DhCheckBox). -->
            <SolidColorBrush x:Key="CheckboxOffBrush" Color="#FFFFFF" />

            <Color x:Key="GlowCobaltColor">#2E1B3FA0</Color>
            <SolidColorBrush x:Key="ThumbBrush" Color="#DBE4F2" />

            <!-- theme-light.css có riêng một `glow-accent` cho nền sáng: cùng mint tối
                 hơn, alpha .16 (nền tối là .14). -->
            <Color x:Key="GlowAccentColor">#17A97C</Color>
            <x:Double x:Key="GlowAccentOpacity">0.16</x:Double>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ===================== Không đổi theo theme ===================== -->

    <!-- Phông — xem ghi chú "PHÔNG CHỮ — CÓ THAY THẾ" ở đầu file -->
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="FontUi">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono</FontFamily>

    <!-- Thang chữ (tokens/typography.css) -->
    <x:Double x:Key="TextHero">62</x:Double>
    <x:Double x:Key="TextDisplay">46</x:Double>
    <x:Double x:Key="TextTitle">32</x:Double>
    <x:Double x:Key="TextSubtitle">24</x:Double>
    <x:Double x:Key="TextStat">34</x:Double>
    <x:Double x:Key="TextBodyLg">15</x:Double>
    <x:Double x:Key="TextBody">14</x:Double>
    <x:Double x:Key="TextBodySm">13</x:Double>
    <x:Double x:Key="TextCaption">12</x:Double>
    <x:Double x:Key="TextMicro">11</x:Double>
    <x:Double x:Key="TextMono">14</x:Double>
    <x:Double x:Key="TextMonoSm">11</x:Double>
    <x:Double x:Key="TextLabel">10</x:Double>

    <!-- Bo góc (tokens/radius.css) — không gì sắc, không gì tròn hẳn trừ pill -->
    <CornerRadius x:Key="RadiusSm">10</CornerRadius>
    <CornerRadius x:Key="RadiusMd">12</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>
    <CornerRadius x:Key="RadiusXl">18</CornerRadius>
    <CornerRadius x:Key="Radius2Xl">22</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Kích thước bố cục dựa vào (tokens/spacing.css) -->
    <x:Double x:Key="RailWidth">74</x:Double>
    <x:Double x:Key="RailItem">42</x:Double>
    <x:Double x:Key="ControlHeightSm">30</x:Double>
    <x:Double x:Key="ControlHeight">38</x:Double>
    <x:Double x:Key="ControlHeightLg">44</x:Double>
    <x:Double x:Key="FieldHeight">66</x:Double>
    <x:Double x:Key="ScreenGutter">56</x:Double>

</ResourceDictionary>

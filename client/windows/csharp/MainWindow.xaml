<?xml version="1.0" encoding="utf-8"?>
<!--
  MainWindow — vỏ cửa sổ: thanh rail 74px bên trái + Frame nội dung bên phải, trên một
  nền có MỘT nguồn sáng cobalt phía sau. Dựng theo `WindowShell` + `Rail` trong
  parts.jsx của dự án thiết kế.

  MỘT NGUỒN SÁNG, KHÔNG PHẢI MỘT LỚP NỀN
    Cái Ellipse mờ phía sau là "đèn" của bản thiết kế: một vệt sáng cobalt hắt từ ngoài
    khung vào, cho nền gần-đen có chiều sâu mà không cần đổ bóng ở đâu cả. Nó nằm ngoài
    mép cửa sổ (Margin âm) đúng như bản gốc — kéo vào giữa màn hình sẽ thành một quầng
    trang trí, khác hẳn về cảm giác.

  RAIL BIẾN MẤT Ở MÀN XEM
    Bản thiết kế vẽ màn xem KHÔNG có rail — cả cửa sổ là hình từ máy kia, mọi điều
    khiển nằm trong HUD nổi. Shell nghe Frame.Navigated và tự ẩn rail, thay vì bắt mỗi
    trang phải nhớ tự làm.
-->
<Window
    x:Class="Deskhub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    Title="Deskhub">

    <Grid x:Name="Root" Background="{ThemeResource BgWindowBrush}">

        <!-- Nguồn sáng cobalt — sau mọi thứ, không nhận chuột. -->
        <Ellipse x:Name="Glow"
                 Width="900" Height="900"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-320,-260,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <media:RadialGradientBrush>
                    <GradientStop Offset="0" Color="{ThemeResource GlowCobaltColor}" />
                    <GradientStop Offset="0.62" Color="#000A2270" />
                </media:RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="74" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===================== THANH RAIL ===================== -->
            <Border x:Name="Rail" Grid.Column="0"
                    Background="{ThemeResource SurfaceCardBrush}"
                    BorderBrush="{ThemeResource BorderHairlineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Width="34" Height="34" Margin="0,18,0,10"
                            CornerRadius="10" HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/appicon.png" Stretch="UniformToFill" />
                    </Border>

                    <!-- Điều hướng: đúng ba đích, khớp RAIL_ITEMS của bản thiết kế -->
                    <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="NavHome" Style="{StaticResource IconButton}" Click="OnNavHome">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE772;" FontSize="19" />
                        </Button>
                        <Button x:Name="NavConnect" Style="{StaticResource IconButton}" Click="OnNavConnect">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE714;" FontSize="19" />
                        </Button>
                        <Button x:Name="NavShare" Style="{StaticResource IconButton}" Click="OnNavShare">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="19" />
                        </Button>
                    </StackPanel>

                    <!-- Chân rail: sáng/tối + ngôn ngữ, đúng chỗ bản thiết kế đặt chúng -->
                    <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Click="OnToggleTheme">
                            <FontIcon x:Name="ThemeIcon" FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE706;" FontSize="18" />
                        </Button>
                        <Button x:Name="LangButton" Click="OnToggleLang"
                                Style="{StaticResource SecondaryButtonSm}"
                                Height="26" Padding="10,0" MinWidth="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Background="{ThemeResource AccentWashBrush}"
                                BorderBrush="{ThemeResource BorderActiveBrush}">
                            <TextBlock x:Name="LangText" Text="EN"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="{StaticResource TextMonoSm}"
                                       Foreground="{ThemeResource AccentBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== NỘI DUNG ===================== -->
            <Frame x:Name="RootFrame" Grid.Column="1" Navigated="OnFrameNavigated" />
        </Grid>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<!--
  App.xaml — nạp hệ thiết kế Deskhub (Themes/Tokens.xaml + Themes/Controls.xaml).

  RequestedTheme KHÔNG đặt ở đây: nó là thuộc tính chỉ-đọc-lúc-khởi-động của
  Application, nên đặt ở đây thì nút sáng/tối trong app sẽ không có tác dụng. Chủ đề
  được áp bằng RequestedTheme trên phần tử gốc của Shell — xem Shell.xaml.cs.
-->
<Application
    x:Class="Deskhub.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
